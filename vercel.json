{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "images": {
    "sizes": [
      320,
      480,
      640,
      828,
      1080,
      1280,
      1600,
      1920
    ],
    "localPatterns": [
      {
        "pathname": "^/.*\\.(png|webp|jpg|jpeg)$",
        "search": ""
      }
    ],
    "minimumCacheTTL": 2678400,
    "qualities": [
      60,
      72,
      80,
      90
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "dangerouslyAllowSVG": false,
    "contentSecurityPolicy": "script-src 'none'; frame-src 'none'; sandbox;",
    "contentDispositionType": "inline"
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "northwestsecurityandlocks.com"
        }
      ],
      "destination": "https://www.northwestsecurityandlocks.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "northwestsecurityandlock.com"
        }
      ],
      "destination": "https://www.northwestsecurityandlocks.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.northwestsecurityandlock.com"
        }
      ],
      "destination": "https://www.northwestsecurityandlocks.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/project/intercom-systems",
      "destination": "/access-control-portland",
      "permanent": true
    },
    {
      "source": "/project/padlocks",
      "destination": "/commercial-locksmith-portland",
      "permanent": true
    },
    {
      "source": "/project/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/assets/01_service_van_4x-optimized.webp",
      "destination": "/assets/northwest-locksmith-service-van.webp",
      "permanent": true
    },
    {
      "source": "/assets/02_locksmith_at_door_hd-optimized.webp",
      "destination": "/assets/residential-locksmith-at-door.webp",
      "permanent": true
    },
    {
      "source": "/assets/03_door_handle_hd-optimized.webp",
      "destination": "/assets/commercial-door-hardware.webp",
      "permanent": true
    },
    {
      "source": "/assets/04_smart_lock_hd-optimized.webp",
      "destination": "/assets/smart-lock-installation.webp",
      "permanent": true
    },
    {
      "source": "/assets/05_lock_and_keys_hd-optimized.webp",
      "destination": "/assets/lock-rekeying-keys.webp",
      "permanent": true
    },
    {
      "source": "/assets/06_lever_handle_hd-optimized.webp",
      "destination": "/assets/commercial-lever-handle.webp",
      "permanent": true
    },
    {
      "source": "/assets/07_before_lock_hd-optimized.webp",
      "destination": "/assets/door-lock-before-replacement.webp",
      "permanent": true
    },
    {
      "source": "/assets/08_after_lock_hd-optimized.webp",
      "destination": "/assets/door-lock-after-replacement.webp",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/:path*.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/:path*.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/:path*.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/:path*.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/:path*.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/:asset(.*\\.[a-f0-9]{12}\\.min\\.(?:css|js))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "buildCommand": "npm run build && npm test",
  "outputDirectory": "dist",
  "installCommand": "npm ci --include=dev",
  "framework": null
}
